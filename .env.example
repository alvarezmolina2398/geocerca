PORT=3000
HOST=0.0.0.0

# Conexion al SQL Server que tiene configurado el linked server GEPROD.
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_LINKED_SERVER=GEPROD

SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000

# Limites por proceso de Node.js. Tiempos en milisegundos.
SQL_POOL_MAX=10
SQL_POOL_MIN=0
SQL_POOL_IDLE_TIMEOUT_MS=30000
SQL_POOL_ACQUIRE_TIMEOUT_MS=30000
