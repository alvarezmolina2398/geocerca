PORT=3000
HOST=0.0.0.0

# Clave requerida en el header x-api-key.
API_KEY=

# Conexion al SQL Server que tiene configurado el linked server GEPROD.
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_LINKED_SERVER=GEPROD

SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000

# Limites por proceso de Node.js. Tiempos en milisegundos.
SQL_POOL_MAX=10
SQL_POOL_MIN=0
SQL_POOL_IDLE_TIMEOUT_MS=30000
SQL_POOL_ACQUIRE_TIMEOUT_MS=30000

# PostgreSQL para consultas independientes en segundo plano.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=5000
PG_QUERY_TIMEOUT_MS=10000
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_MAX_PENDING=100
